MicroMaya.app/Contents/PkgInfo: 
	@test -d MicroMaya.app/Contents || mkdir -p MicroMaya.app/Contents
	@$(DEL_FILE) MicroMaya.app/Contents/PkgInfo
	@echo "APPL????" > MicroMaya.app/Contents/PkgInfo
MicroMaya.app/Contents/Info.plist: 
	@test -d MicroMaya.app/Contents || mkdir -p MicroMaya.app/Contents
	@$(DEL_FILE) MicroMaya.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /Users/adam/Qt/6.11.2/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.MicroMaya,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.MicroMaya,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,MicroMaya,g" -e "s,@LIBRARY@,MicroMaya,g" -e "s,\$${EXECUTABLE_NAME},MicroMaya,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >MicroMaya.app/Contents/Info.plist

