	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../glsl.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/la.h ../../src/mainwindow.h ../../src/mygl.h ../../src/shaderprogram.h ../../src/utils.h ../../src/drawable.h ../../src/camera.h ../../src/openglcontext.h ../../src/scene/squareplane.h ../../src/scene/vertex.h ../../src/scene/face.h ../../src/scene/halfedge.h ../../src/scene/mesh.h ../../src/scene/componentdisplay.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/main.cpp ../../src/mainwindow.cpp ../../src/mygl.cpp ../../src/shaderprogram.cpp ../../src/utils.cpp ../../src/la.cpp ../../src/drawable.cpp ../../src/camera.cpp ../../src/openglcontext.cpp ../../src/scene/squareplane.cpp ../../src/scene/vertex.cpp ../../src/scene/face.cpp ../../src/scene/halfedge.cpp ../../src/scene/mesh.cpp ../../src/scene/componentdisplay.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../../forms/mainwindow.ui $(DISTDIR)/


